# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://estateflow:estateflow_dev@localhost:5432/estateflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estateflow
DB_USER=estateflow
DB_PASSWORD=estateflow_dev

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Auth / JWT ────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=10

# ── Mapbox (optional — falls back to MapLibre + OSM) ─────
MAPBOX_TOKEN=

# ── Twilio SMS (optional — falls back to console mock) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── WhatsApp Cloud API (optional — falls back to console mock)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── File uploads ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_MAX=5

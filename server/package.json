{
  "name": "@estateflow/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:up": "node-pg-migrate up --migration-file-language ts --migrations-dir db/migrations --envPath ../.env",
    "migrate:down": "node-pg-migrate down --migration-file-language ts --migrations-dir db/migrations --envPath ../.env",
    "migrate:create": "node-pg-migrate create --migration-file-language ts --migrations-dir db/migrations",
    "seed": "tsx db/seeds/seed.ts",
    "seed:perf": "tsx db/seeds/performance-seed.ts",
    "benchmark": "tsx db/benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@estateflow/shared": "file:../shared",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "pg-boss": "^10.1.5",
    "express-rate-limit": "^7.4.1",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "swagger-ui-express": "^5.0.1",
    "node-pg-migrate": "^7.8.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.11.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "vitest": "^2.1.5",
    "supertest": "^7.0.0",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0"
  }
}
